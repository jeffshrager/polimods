__pycache__/
*.py[cod]
.pytest_cache/
*.egg-info/
build/
dist/
.venv/
venv/

.DS_Store

# Per-election output can reach hundreds of MB and is regenerable from the
# manifest.  The spec, manifest.json and runs.csv are committed: together they
# are the record of what was run, and the manifest is worth little without the
# results it describes.
experiments/**/steps.csv
experiments/**/*.png

# Exception: figures a paper/ draft embeds are part of the delivered document,
# not exploratory scan output, so they're committed alongside the prose that
# cites them.
!experiments/**/paper/*.png
